{
  "name": "omp-roundtable",
  "version": "0.1.34",
  "description": "Roundtable delivery for Oh My Pi: tickets move along a configurable workflow state machine, with durable local protocol state, isolated seats, source-confirmed effects, and native scheduling.",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package", "pi-extension", "omp"],
  "files": ["index.ts", "src/", "agents/", "README.md", "LICENSE"],
  "bin": {
    "omp-roundtable-launcher": "./src/launcher/cli.ts"
  },
  "omp": {
    "extensions": ["./index.ts"],
    "settings": {
      "workflowFile": {
        "type": "string",
        "description": "Workflow file path, relative to the coordinator working directory",
        "env": "OMP_ROUNDTABLE_WORKFLOW"
      }
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test",
    "sim": "bun tests/sim/run.ts"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "^18.12.6",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "@oh-my-pi/omptype": "^18.12.6"
  }
}
